    "stages": [
      {
        "id": "start",
        "title": "起步期",
        "subtitle": "先推进，再展开",
        "steps": [
          "沿主线解锁可参与的玩法，建立挂机和任务的稳定来源。",
          "确定主要输出与必要辅助，优先补关键技能解锁。",
          "每次投入前先查下一阶段的材料，不把同一种材料同时分给全部武将。"
        ]
      },
      {
        "id": "middle",
        "title": "成型期",
        "subtitle": "围绕阵容补短板",
        "steps": [
          "对照正在使用的阵容，核对突破、装备和英魂的缺口。",
          "把固定奖励、兑换和随机获取分开预算，先安排确定能拿到的材料。",
          "保留活动兑换货币，确认兑换期、限购次数与所需前置。"
        ]
      },
      {
        "id": "late",
        "title": "后期",
        "subtitle": "按目标做专项预算",
        "steps": [
          "以目标武将、属性和节点列预算，避免按收集数量推断已经全满养成。",
          "当前参考账号已到 Lv.270，可把注意力放在具体节点、装备分支与阵容目标选取。",
          "用相同敌人、相近配置和完整战报比较调整；界面战力不能直接当作胜率。"
        ]
      }
    ]
  },
  "teams": [
    {
      "id": "delegation",
      "name": "委托攻击框架",
      "tag": "目标选取",
      "icon": "Users",
      "scene": "需要多核心参与输出的对局",
      "core": [
        "逆行时空·黄月英",
        "攻击力核心",
        "力量／智力／敏捷核心",
        "解控与生存辅助"
      ],
      "logic": "黄月英的主动技能会选择攻击力或三种属性的最高者执行攻击。搭配重点是把各项最高值交给准备承担输出的武将。",
      "steps": [
        "逐项确认攻击、力量、智力、敏捷最高者，允许同一人占多项，但要按实际面板核对。",
        "先补核心的生存与技能发动条件，避免辅助吸走关键属性目标。",
        "对委托伤害及追加技能检查完整战报，不能只看技能成功返回。"
      ],
      "limits": "抗性、目标免疫和战报实现可能改变表现；尚未做此套阵容的胜率实测。",
      "evidence": [
        {
          "heroId": 608110,
          "hero": "逆行时空·黄月英",
          "id": 6081101,
          "name": "幻念归流",
          "description": "选择随机2个敌方武将，清除目标全部强化效果，使目标进入「心智囚念」（无视目标不良状态耐性，持续20回合）。对目标造成2次伤害，每次造成6%自身最大生命值的真实伤害（无视防御，无视抗性，无视伤害的提升和降低）。\n选择攻击力最高的3个己方武将，清除目标全部不良状态。使目标的攻击力+100%，并使每个武将分别对处於「心智囚念」的敌方武将造成2次伤害，每次造成1000%攻击力的真实伤害（无视防御，无视抗性，有概率会心一击）。\n如果当前回合≥8，追加释放1次「幻念归流」（最大触发1次）。\n「心智囚念」：物理伤害-200%，法术伤害-200%，生命值吸收-100%。每次受到回复效果时，如果自身的生命值＜50%，无法回复生命值（最大触发3次，再次获得「心智囚念」状态时重置次数）。不可清除，不可复制，不可偷取，最大持续20回合。",
          "source": "Skill / 6081101",
          "version": "0.840.57"
        },
        {
          "heroId": 608110,
          "hero": "逆行时空·黄月英",
          "id": 6081102,
          "name": "情弦倒转·可逆",
          "description": "选择随机1个敌方武将，使目标随机5个强化效果-20回合。对目标造成4次伤害，每次造成6%自身最大生命值的真实伤害（无视防御，无视抗性，无视伤害的提升和降低）。\n选择攻击力最高的1个己方武将，使目标对攻击力最低的3个敌方造成1000%攻击力的真实伤害（无视防御，无视抗性，有概率会心一击）。选择力量值最高的1个武将，使目标对力量值最低的3个敌方造成200000%力量值的真实伤害（无视防御，无视抗性，有概率会心一击）。选择智力值最高的1个武将，使目标对智力值最低的3个敌方造成200000%智力值的真实伤害（无视防御，无视抗性，有概率会心一击）。选择敏捷值最高的1个武将，使目标对敏捷值最低的3个敌方造成200000%敏捷值的真实伤害（无视防御，无视抗性，有概率会心一击）。\n如果己方攻击力最高的武将的攻击力大於敌方攻击力最高的武将的攻击力，追加释放1次「情弦倒转·可逆」（最大触发1次）。\n如果己方生命值上限最高的武将的生命值上限大於敌方生命值上限最高的武将的生命值上限，追加释放1次「情弦倒转·可逆」（最大触发1次）。",
          "source": "Skill / 6081102",
          "version": "0.840.57"
        }
      ]
    },
    {
